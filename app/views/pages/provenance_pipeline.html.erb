<% content_for :share_image, t('portfolio.provenance_pipeline.images.banner') %>
<% repo_url = "https://github.com/ZPAlexis/provenance-pipeline" %>
<main class="main-container pp-page">
  <section class="post-section">
    <%= image_tag t('portfolio.provenance_pipeline.images.banner'), alt: t('portfolio.provenance_pipeline.alt.banner'), class: "post-banner-image cover no-aspect-ratio" %>
    <div class="post-container">
      <h1 class="post-heading title center"><%= t('portfolio.provenance_pipeline.title') %></h1>
      <p class="post-text center"><%= t('portfolio.provenance_pipeline.subtitle') %></p>

      <div class="post-intro-wrapper not-selectable">
        <div class="post-list-container center gap">
          <p class="post-text"><%= t('portfolio.provenance_pipeline.category_html') %></p>
          <div>
            <p class="post-text"><%= t('portfolio.provenance_pipeline.stack_html') %></p>
            <div class="project-summary-tags portfolio not-selectable">
              <div class="stack-tag portfolio">Ruby on Rails</div>
              <div class="stack-tag portfolio">PostgreSQL</div>
              <div class="stack-tag portfolio">Python</div>
              <div class="stack-tag portfolio">Claude API</div>
              <div class="stack-tag portfolio">MCP</div>
              <div class="stack-tag portfolio">GitHub Actions</div>
            </div>
          </div>
        </div>
        <div class="post-spacing"></div>
        <div class="post-list-container">
          <h3 class="post-text text-highlight"><%= t('portfolio.provenance_pipeline.index') %></h3>
          <p class="post-list-item post-text gold">><a class="post-list-item post-text" href="#problem"><%= t('portfolio.provenance_pipeline.problem_heading') %></a></p>
          <p class="post-list-item post-text gold">><a class="post-list-item post-text" href="#solution"><%= t('portfolio.provenance_pipeline.solution_heading') %></a></p>
          <p class="post-list-item post-text gold">-><a class="post-list-item post-text" href="#architecture"><%= t('portfolio.provenance_pipeline.architecture_heading') %></a></p>
          <p class="post-list-item post-text gold">-><a class="post-list-item post-text" href="#governance"><%= t('portfolio.provenance_pipeline.governance_heading') %></a></p>
          <p class="post-list-item post-text gold">-><a class="post-list-item post-text" href="#verification"><%= t('portfolio.provenance_pipeline.verification_heading') %></a></p>
          <p class="post-list-item post-text gold">-><a class="post-list-item post-text" href="#human-loop"><%= t('portfolio.provenance_pipeline.human_heading') %></a></p>
          <p class="post-list-item post-text gold">-><a class="post-list-item post-text" href="#assistant"><%= t('portfolio.provenance_pipeline.assistant_heading') %></a></p>
          <p class="post-list-item post-text gold">><a class="post-list-item post-text" href="#results"><%= t('portfolio.provenance_pipeline.results_heading') %></a></p>
          <p class="post-list-item post-text gold">><a class="post-list-item post-text" href="#plan"><%= t('portfolio.provenance_pipeline.plan_heading') %></a></p>
          <p class="post-list-item post-text gold">><a class="post-list-item post-text" href="#highlights"><%= t('portfolio.provenance_pipeline.highlights_heading') %></a></p>
          <p class="post-list-item post-text gold">><a class="post-list-item post-text" href="#next"><%= t('portfolio.provenance_pipeline.next_heading') %></a></p>
        </div>
      </div>

      <div class="post-spacing"></div>
      <%= github_doc_button "#{repo_url}?tab=readme-ov-file", path: "README.md", label: t('portfolio.provenance_pipeline.docs_btn') %>

      <%# 2. Why I built it %>
      <div class="post-spacing"></div>
      <div class="post-quote-box titled">
        <p class="post-text"><%= t('portfolio.provenance_pipeline.why_quote') %></p>
        <p class="post-text"><%= t('portfolio.provenance_pipeline.why_2') %></p>
      </div>

      <%# 1. Overview %>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.overview_1') %></p>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.overview_2_html') %></p>
      <ul class="post-bullet-list">
        <% 1.upto(4) do |i| %>
          <li><%= t("portfolio.provenance_pipeline.overview_li_#{i}") %></li>
        <% end %>
      </ul>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.overview_3_html') %></p>
      <%= post_image_or_placeholder t('portfolio.provenance_pipeline.images.concepts'), alt: t('portfolio.provenance_pipeline.alt.concepts') %>

      <%# 3. Problem %>
      <div class="post-spacing-large"></div>
      <h2 class="post-heading" id="problem"><%= t('portfolio.provenance_pipeline.problem_heading') %></h2>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.problem_1') %></p>
      <ol type="1" class="post-text">
        <% 1.upto(5) do |i| %>
          <li><%= t("portfolio.provenance_pipeline.problem_li_#{i}_html") %></li>
        <% end %>
      </ol>

      <%# 4. Solution %>
      <div class="post-spacing-large"></div>
      <h2 class="post-heading" id="solution"><%= t('portfolio.provenance_pipeline.solution_heading') %></h2>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.solution_quote') %></p>

      <%# 1a. What it maps to in a revenue team %>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.mapping_lead') %></p>
      <table class="post-table">
        <thead>
          <tr>
            <th scope="col"><%= t('portfolio.provenance_pipeline.mapping.col_revenue') %></th>
            <th scope="col"><%= t('portfolio.provenance_pipeline.mapping.col_project') %></th>
          </tr>
        </thead>
        <tbody>
          <% 1.upto(10) do |i| %>
            <tr>
              <td class="post-table-key" data-label="<%= t('portfolio.provenance_pipeline.mapping.col_revenue') %>"><%= t("portfolio.provenance_pipeline.mapping.row_#{i}.revenue") %></td>
              <td data-label="<%= t('portfolio.provenance_pipeline.mapping.col_project') %>"><%= t("portfolio.provenance_pipeline.mapping.row_#{i}.project") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= github_doc_button "#{repo_url}#how-this-maps-to-gtm-work", path: "README.md", label: t('portfolio.provenance_pipeline.mapping_btn') %>

      <%# 4.1 Architecture %>
      <div class="post-spacing"></div>
      <h3 class="post-heading" id="architecture"><%= t('portfolio.provenance_pipeline.architecture_heading') %></h3>
      <%= post_image_or_placeholder t('portfolio.provenance_pipeline.images.architecture'), alt: t('portfolio.provenance_pipeline.alt.architecture') %>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.architecture_1') %></p>
      <ul class="post-bullet-list">
        <% 1.upto(2) do |i| %>
          <li><%= t("portfolio.provenance_pipeline.architecture_li_#{i}_html") %></li>
        <% end %>
      </ul>

      <%# 4.2 Governance %>
      <div class="post-spacing-large"></div>
      <h3 class="post-heading" id="governance"><%= t('portfolio.provenance_pipeline.governance_heading') %></h3>
      <%= post_image_or_placeholder t('portfolio.provenance_pipeline.images.governance'), alt: t('portfolio.provenance_pipeline.alt.governance') %>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.governance_1') %></p>
      <ul class="post-bullet-list">
        <% 1.upto(5) do |i| %>
          <li><%= t("portfolio.provenance_pipeline.governance_li_#{i}_html") %></li>
        <% end %>
      </ul>

      <div class="post-spacing"></div>
      <p class="post-text-title highlight"><%= t('portfolio.provenance_pipeline.who.title') %></p>
      <table class="post-table">
        <thead>
          <tr>
            <th scope="col"><%= t('portfolio.provenance_pipeline.who.col_who') %></th>
            <th scope="col"><%= t('portfolio.provenance_pipeline.who.col_may') %></th>
            <th scope="col"><%= t('portfolio.provenance_pipeline.who.col_never') %></th>
          </tr>
        </thead>
        <tbody>
          <% 1.upto(8) do |i| %>
            <% note = t("portfolio.provenance_pipeline.who.row_#{i}.note", default: "") %>
            <tr>
              <td class="post-table-key" data-label="<%= t('portfolio.provenance_pipeline.who.col_who') %>">
                <%= t("portfolio.provenance_pipeline.who.row_#{i}.name") %>
                <% if note.present? %><span class="post-table-note"><%= note %></span><% end %>
              </td>
              <td data-label="<%= t('portfolio.provenance_pipeline.who.col_may') %>"><%= t("portfolio.provenance_pipeline.who.row_#{i}.may") %></td>
              <td data-label="<%= t('portfolio.provenance_pipeline.who.col_never') %>"><%= t("portfolio.provenance_pipeline.who.row_#{i}.never") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= github_doc_button "#{repo_url}/blob/main/docs/governance.md", path: "docs/governance.md", label: t('portfolio.provenance_pipeline.governance_btn') %>

      <%# 4.3 Source verification %>
      <div class="post-spacing-large"></div>
      <h3 class="post-heading" id="verification"><%= t('portfolio.provenance_pipeline.verification_heading') %></h3>
      <%= post_image_or_placeholder t('portfolio.provenance_pipeline.images.verification'), alt: t('portfolio.provenance_pipeline.alt.verification') %>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.verification_1') %></p>
      <ul class="post-bullet-list">
        <li><%= t('portfolio.provenance_pipeline.verification_case_a_html') %></li>
        <li><%= t('portfolio.provenance_pipeline.verification_case_b_html') %></li>
      </ul>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.verification_2_html') %></p>
      <ul class="post-bullet-list">
        <% 1.upto(3) do |i| %>
          <li><%= t("portfolio.provenance_pipeline.verification_li_#{i}_html") %></li>
        <% end %>
      </ul>

      <%# 4.4 Human in the loop %>
      <div class="post-spacing-large"></div>
      <h3 class="post-heading" id="human-loop"><%= t('portfolio.provenance_pipeline.human_heading') %></h3>
      <%= post_image_or_placeholder t('portfolio.provenance_pipeline.images.loop'), alt: t('portfolio.provenance_pipeline.alt.loop') %>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.human_1_html') %></p>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.human_2') %></p>

      <%# 4.5 MCP server %>
      <div class="post-spacing-large"></div>
      <h3 class="post-heading" id="assistant"><%= t('portfolio.provenance_pipeline.assistant_heading') %></h3>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.assistant_1_html') %></p>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.assistant_tools_intro') %></p>
      <ul class="post-bullet-list">
        <% 1.upto(6) do |i| %>
          <li><%= t("portfolio.provenance_pipeline.assistant_tools_li_#{i}_html") %></li>
        <% end %>
      </ul>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.assistant_2_html') %></p>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.assistant_3') %></p>

      <%# 5. Measured results %>
      <div class="post-spacing-large"></div>
      <h2 class="post-heading" id="results"><%= t('portfolio.provenance_pipeline.results_heading') %></h2>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.results_1') %></p>
      <div class="post-results">
        <% 1.upto(5) do |i| %>
          <% card = "portfolio.provenance_pipeline.results.card_#{i}" %>
          <% parts = t("#{card}.parts", default: nil) %>
          <% date = t("#{card}.date", default: "") %>
          <div class="post-result-card">
            <% if parts.is_a?(Hash) %>
              <div class="post-result-parts">
                <% parts.each_value do |part| %>
                  <div class="post-result-part">
                    <span class="post-result-figure"><%= part[:value] %></span>
                    <span class="post-result-part-label"><%= part[:label] %></span>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="post-result-figure"><%= t("#{card}.figure") %></p>
            <% end %>
            <div class="post-result-body">
              <p class="post-result-label"><%= t("#{card}.label") %></p>
              <p class="post-result-text"><%= t("#{card}.text_html", default: "").presence || t("#{card}.text") %></p>
              <% if date.present? %><p class="post-result-date"><%= date %></p><% end %>
            </div>
          </div>
        <% end %>
      </div>
      <%= github_doc_button "#{repo_url}#measured-results", path: "README.md", label: t('portfolio.provenance_pipeline.results_btn') %>

      <%# 6. Project plan %>
      <div class="post-spacing-large"></div>
      <h2 class="post-heading" id="plan"><%= t('portfolio.provenance_pipeline.plan_heading') %></h2>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.plan_1') %></p>
      <%= post_image_or_placeholder t('portfolio.provenance_pipeline.images.plan'), alt: t('portfolio.provenance_pipeline.alt.plan') %>
      <%= github_doc_button "#{repo_url}/blob/main/docs/build-stages.md", path: "docs/build-stages.md", label: t('portfolio.provenance_pipeline.plan_btn') %>

      <%# 8. How I built it %>
      <div class="post-spacing"></div>
      <div class="post-quote-box titled">
        <p class="post-text-title highlight"><%= t('portfolio.provenance_pipeline.how_built_heading') %></p>
        <p class="post-text"><%= t('portfolio.provenance_pipeline.how_built_quote') %></p>
      </div>

      <%# 7. Highlights %>
      <div class="post-spacing-large"></div>
      <h2 class="post-heading" id="highlights"><%= t('portfolio.provenance_pipeline.highlights_heading') %></h2>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.highlights_1') %></p>
      <ol type="1" class="post-text post-text-large-marker">
        <% 1.upto(5) do |i| %>
          <li><%= t("portfolio.provenance_pipeline.highlights_li_#{i}_html") %></li>
        <% end %>
      </ol>
      <%= github_doc_button "#{repo_url}/blob/main/docs/design-principles.md", path: "docs/design-principles.md", label: t('portfolio.provenance_pipeline.highlights_btn') %>

      <%# 9. What's next %>
      <div class="post-spacing-large"></div>
      <h2 class="post-heading" id="next"><%= t('portfolio.provenance_pipeline.next_heading') %></h2>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.next_1') %></p>
      <ol type="1" class="post-bullet-list">
        <% 1.upto(3) do |i| %>
          <li><%= t("portfolio.provenance_pipeline.next_li_#{i}_html") %></li>
        <% end %>
      </ol>

      <%# 10. Closing %>
      <div class="post-spacing-large"></div>
      <%= image_tag t('portfolio.provenance_pipeline.images.icon'), alt: t('portfolio.provenance_pipeline.alt.icon'), class: "post-image app xsmaller center" %>
      <div class="post-spacing-large"></div>
      <p class="post-text"><%= t('portfolio.provenance_pipeline.closing_2_html') %></p>

      <div class="post-quote-box titled">
        <p class="post-text-title highlight"><%= t('portfolio.provenance_pipeline.title') %></p>
        <p class="post-text"><%= t('portfolio.provenance_pipeline.closing_1') %></p>
      </div>
      <div class="post-spacing"></div>
      <%= github_doc_button "#{repo_url}/tree/main#documentation", path: "README.md", label: t('portfolio.provenance_pipeline.docs_btn') %>
      <div class="post-spacing"></div>
      <div class="post-line"></div>
    </div>
  </section>

  <section class="post-references-section">
    <div class="post-references-container">
      <p class="post-text center half text-highlight"><%= t('about.cta_projects') %></p>
      <%= render "shared/projects_list", skip: "provenance_pipeline" %>
    </div>
  </section>
</main>
